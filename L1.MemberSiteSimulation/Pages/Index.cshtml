@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-left">
    <form method="post" target="_blank">
        <label for="MemberId">Member ID:</label>
        <input asp-for="MemberId" />
        <br />
        <label for="MemberName">Member Username:</label>
        <input asp-for="MemberName" />
        <br />
        <label for="Language">Language:</label>
        <select asp-for="Language"
                asp-items="@(new SelectList(Model.Languages,"Value","Name", Model.Language))">
        </select>
        <br />
        <label asp-for="Currency">Currency:</label>
        <select asp-for="Currency" asp-items="Model.Currencies"></select>
        <br />
        <label asp-for="GameId">Game:</label>
        <select asp-for="GameId" asp-items="@(new SelectList(Model.Games,"Id","Name", Model.GameId))"></select>
        <br />
        <label asp-for="Seq">Seq:</label>
        <input asp-for="Seq" />
        <br />

        <input type="submit" value="SSO" />
    </form>
</div>

<div class="text-center">
    @if (!string.IsNullOrWhiteSpace(Model.SingleSignOnResult?.RedirectUri?.ToString()))
        {
    @:Redirect Url:
    <a href="@(Model.SingleSignOnResult.RedirectUri)">@(Model.SingleSignOnResult.RedirectUri)</a>
        }
    <div>@Model.SingleSignOnResult?.Error?.Message</div>
</div>