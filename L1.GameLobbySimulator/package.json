{
  "name": "game-lobby-simulator",
  "version": "0.0.0",
  "private": true,
  "main": "app.js",
  "scripts": {
    "start": "nodemon .",
    "webpack:dev": "webpack --watch --mode development",
    "dev": "concurrently --kill-others \"npm run webpack:dev\" \"nodemon .\"",
    "build": "webpack",
    "build:sit": "webpack && cp game-client-config.SIT.json game-client-config.json",
    "build:uat": "webpack && cp game-client-config.UAT.json game-client-config.json"
  },
  "description": "GameLobbySimulator",
  "author": {
    "name": ""
  },
  "dependencies": {
    "body-parser": "^1.15.0",
    "cookie-parser": "^1.4.0",
    "debug": "^2.2.0",
    "express": "^4.14.0",
    "l1.client.node-js": "file:./L1.Client.NodeJS",
    "morgan": "^1.7.0",
    "pug": "^2.0.0-beta6",
    "serve-favicon": "^2.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.4",
    "@babel/preset-env": "^7.8.4",
    "@babel/preset-react": "^7.8.3",
    "axios": "^0.19.2",
    "babel-loader": "^8.0.6",
    "concurrently": "^5.1.0",
    "history": "^4.10.1",
    "nodemon": "^2.0.2",
    "react": "^16.13.0",
    "react-dom": "^16.13.0",
    "react-router-dom": "^5.1.2",
    "webpack": "^4.42.0",
    "webpack-cli": "^3.3.11"
  }
