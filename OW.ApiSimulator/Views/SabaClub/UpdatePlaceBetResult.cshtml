@model OW.ApiSimulator.Models.OW.PlaceBetResult

<h3>Update Place Bet Result</h3>

<form method="post">
    <div class="form-group">
        <label asp-for="ErrorCode"></label>
        <input class="form-control" asp-for="ErrorCode" />
    </div>
    <div class="form-group">
        <label asp-for="ErrorDescription"></label>
        <input class="form-control" asp-for="ErrorDescription" />
    </div>
    <div class="form-group">
        <label asp-for="ObTransId"></label>
        <input class="form-control" asp-for="ObTransId" />
    </div>
    <div class="form-group">
        <label asp-for="DelayTime"></label>
        <input class="form-control" asp-for="DelayTime" />
    </div>
    <div class="form-group">
        <label asp-for="MinBet"></label>
        <input class="form-control" asp-for="MinBet" />
    </div>
    <div class="form-group">
        <label asp-for="MaxBet"></label>
        <input class="form-control" asp-for="MaxBet" />
    </div>
    <input class="btn btn-primary" type="submit" value="Save" />
</form>