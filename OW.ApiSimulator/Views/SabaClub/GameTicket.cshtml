@model GameTicketRequestViewModel
    <form method="post" target="_blank">
        <div class="form-group">
            <label>Game Type</label>
            <input class="form-control" type="number" asp-for="GameTypeId" />
        </div>
        <div class="form-group">
            <label>Round Id</label>
            <input class="form-control" type="number" asp-for="GameRoundId" />
        </div>
        <div class="form-group">
            <label>Member Id</label>
            <input class="form-control" type="number" asp-for="ObCustId" />
        </div>

        <div class="form-group">
            <label>Language</label>
            <select class="form-control" type="number" asp-for="Culture">
                <option value="en-US">English</option>
                <option value="vi-VN">Vietnamese</option>
            </select>
        </div>
        <input class="btn btn-primary" type="submit" value="Submit" />
    </form>