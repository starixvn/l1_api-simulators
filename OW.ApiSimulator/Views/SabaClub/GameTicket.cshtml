@model GameTicketRequestViewModel
<form method="post" target="_blank">
    <div class="form-group">
        <label>Game Type</label>
        <input class="form-control" type="number" asp-for="GameTypeId"/>
    </div>
    <div class="form-group">
        <label>Round Id</label>
        <input class="form-control" type="number" asp-for="RoundId" />
    </div>
    <div class="form-group">
        <label>Member Id</label>
        <input class="form-control" type="number" asp-for="MemberId"/>
    </div>
    <input class="btn btn-primary" type="submit" value="Submit" />
</form>