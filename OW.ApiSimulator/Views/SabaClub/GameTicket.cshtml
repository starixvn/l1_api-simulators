@model GameTicketRequestViewModel
<form method="post" target="_blank">
    <fieldset>
        <legend>Auth</legend>
        <div class="form-group">
            <label asp-for="Request.Auth.OperatorId"></label>
            <input class="form-control" asp-for="Request.Auth.OperatorId" />
        </div>
        <div class="form-group">
            <label asp-for="Request.Auth.OperatorSecret"></label>
            <input class="form-control" asp-for="Request.Auth.OperatorSecret" />
        </div>
    </fieldset><div class="form-group">
        <label>Game Type</label>
        <input class="form-control" type="number" asp-for="Request.GameTypeId" />
    </div>
    <div class="form-group">
        <label>Round Id</label>
        <input class="form-control" type="number" asp-for="Request.GameRoundId" />
    </div>
    <div class="form-group">
        <label>Member Id</label>
        <input class="form-control" type="number" asp-for="Request.ObCustId" />
    </div>

    <div class="form-group">
        <label>Language</label>
        <select class="form-control" type="number" asp-for="Request.Language">
            <option value="en-US">English</option>
            <option value="vi-VN">Vietnamese</option>
            <option value="id-ID">Indonesian</option>
            <option value="th-TH">Thailand</option>
            <option value="zh-CN">Chinese (Simplified)</option>
            <option value="zh-TW">Chinese (Original)</option>
        </select>
    </div>
    <input class="btn btn-primary" type="submit" value="Submit" />
</form>