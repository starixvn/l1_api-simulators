@{
    ViewData["Title"] = "RetrieveEndGameInfo";
}

@model RetriveEndGameInfoViewModel

    <form method="post" id="form">
        <fieldset>
            <legend>Auth</legend>
            <div class="form-group">
                <label asp-for="Request.Auth.PartnerId"></label>
                <input class="form-control" asp-for="Request.Auth.PartnerId" />
            </div>
            <div class="form-group">
                <label asp-for="Request.Auth.PartnerSecret"></label>
                <input class="form-control" asp-for="Request.Auth.PartnerSecret" />
            </div>
        </fieldset>
        <div class="form-group">
            <label asp-for="Request.TimeStamp"></label>
            <input class="form-control" asp-for="Request.TimeStamp" readonly />
        </div>
        <div class="form-group">
            <label asp-for="Request.Seq"></label>
            <input class="form-control" asp-for="Request.Seq" readonly />
        </div>
        <div class="form-group">
            <label asp-for="Request.GameRoundId"></label>
            <input class="form-control" asp-for="Request.GameRoundId" />
        </div>
        <div class="form-group">
            <label asp-for="Request.GameTypeId"></label>
            <input class="form-control" asp-for="Request.GameTypeId" />
        </div>
        <div class="form-group">
            <label asp-for="Request.SiteId"></label>
            <input class="form-control" asp-for="Request.SiteId" />
        </div>
        <div class="form-group">
            <label asp-for="Request.ObCustId"></label>
            <input class="form-control" asp-for="Request.ObCustId" />
        </div>

        <input class="btn btn-primary" type="submit" value="Submit" />
    </form>

<fieldset>
    <legend>Result</legend>
    <pre>
        @Html.Raw(Json.Serialize(Model.Result))
    </pre>
</fieldset>