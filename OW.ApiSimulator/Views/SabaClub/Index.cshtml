@inject List<Partner> Partners

<div>
    <div>Customer</div>
    <ul>
        <li><a target="_blank" asp-action="CreateCustomer">Create</a></li>
        <li><a target="_blank" asp-action="UpdateCustomerBalance">Update Balance</a></li>
    </ul>
</div>

<div>
    <div>Update Partner Results:</div>
    <ul>
        @foreach (var partner in Partners)
        {
            <li><a target="_blank" asp-action="UpdatePartner" asp-route-name="@partner.Name">@partner.Name</a></li>

        }

    </ul>
</div>

<div>
    <div>Saba Club API:</div>
    <ul>
        <li><a target="_blank" asp-action="RetrieveEndGameInfo">Retrieve End Game Info</a></li>
        <li><a target="_blank" asp-action="GameTicket">Game Ticket</a></li>
    </ul>
</div>