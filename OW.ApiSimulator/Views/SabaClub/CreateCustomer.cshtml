@model OW.ApiSimulator.Models.Customer

<h3>Create Customer</h3>

<form method="post">
    <div class="form-group">
        <label asp-for="ObCustId"></label>
        <input class="form-control" asp-for="ObCustId" />
    </div>
    <div class="form-group">
        <label asp-for="Balance"></label>
        <input class="form-control" asp-for="Balance" />
    </div>
    <div class="form-group">
        <label asp-for="MinBet"></label>
        <input class="form-control" asp-for="MinBet" />
    </div>
    <div class="form-group">
        <label asp-for="MaxBet"></label>
        <input class="form-control" asp-for="MaxBet" />
    </div>
    <h4>Delay Time</h4>
    <div class="form-group row">
        <div class="col-6">
            <label asp-for="Delay.GetBalance">GetBalance</label>
            <input class="form-control" asp-for="Delay.GetBalance" />
        </div>
        <div class="col-6">
            <label asp-for="Delay.PlaceBet">PlaceBet</label>
            <input class="form-control" asp-for="Delay.PlaceBet" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-6">
            <label asp-for="Delay.EndGame">EndGame</label>
            <input class="form-control" asp-for="Delay.EndGame" />
        </div>
        <div class="col-6">
            <label asp-for="Delay.GetBetLimit">GetBetLimit</label>
            <input class="form-control" asp-for="Delay.GetBetLimit" />
        </div>
    </div>
    <h4>Error Codes</h4>
    <div class="form-group row">
        <div class="col-6">
            <label asp-for="ErrorCode.GetBalance">GetBalance</label>
            <input class="form-control" asp-for="ErrorCode.GetBalance" />
        </div>
        <div class="col-6">
            <label asp-for="ErrorCode.PlaceBet">PlaceBet</label>
            <input class="form-control" asp-for="ErrorCode.PlaceBet" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-6">
            <label asp-for="ErrorCode.EndGame">EndGame</label>
            <input class="form-control" asp-for="ErrorCode.EndGame" />
        </div>
        <div class="col-6">
            <label asp-for="ErrorCode.GetBetLimit">GetBetLimit</label>
            <input class="form-control" asp-for="ErrorCode.GetBetLimit" />
        </div>
    </div>

    <input class="btn btn-primary" type="submit" value="Save" />
</form>